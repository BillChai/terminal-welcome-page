# terminal-welcome-page config.
#
# Copy to ~/.config/terminal-welcome-page/config.env and edit (install.sh does
# this for you automatically on first install, and never overwrites it after).
#
# This file is sourced by shell/twp.zsh every time a new terminal opens. A typo
# here just falls back to the default for that one setting — it never breaks
# your shell.

export TWP_NAME="Chai"

# One of: typewriter (default), wave, bounce
export TWP_ANIMATION="typewriter"

# Milliseconds, clamped to 0..1500 (default 700). Kept short on purpose so it
# doesn't cancel out Powerlevel10k's instant prompt or similar.
export TWP_DURATION_MS=700

# Frames per second, clamped to 5..60 (default 30)
export TWP_FPS=30
